  <script>
    (function() {
      // ----- realistic price simulation -----
      // Base prices
      const assets = {
        BTC: { price: 63842.10, change: 2.34, elementPrice: 'btc-price', elementChange: 'btc-change' },
        ETH: { price: 3412.75, change: 1.12, elementPrice: 'eth-price', elementChange: 'eth-change' },
        SOL: { price: 142.30, change: -0.87, elementPrice: 'sol-price', elementChange: 'sol-change' },
        AAPL: { price: 226.84, change: 0.54, elementPrice: 'aapl-price', elementChange: 'aapl-change' },
        TSLA: { price: 248.50, change: -1.23, elementPrice: 'tsla-price', elementChange: 'tsla-change' }
      };

      // Chart reference and data
      const canvas = document.getElementById('priceChart');
      const ctx = canvas.getContext('2d');

      // generate realistic looking chart data (30 points)
      let chartData = [];
      let basePrice = 63842.10;
      for (let i = 0; i < 30; i++) {
        // random walk with slight upward bias
        const variation = (Math.random() - 0.48) * 150;
        basePrice += variation;
        chartData.push(basePrice);
      }
      // set last point to current BTC price
      chartData[chartData.length - 1] = 63842.10;

      // function to draw smooth chart with gradient
      function drawChart() {
        const w = canvas.width;
        const h = canvas.height;
        ctx.clearRect(0, 0, w, h);

        if (!chartData.length) return;

        const min = Math.min(...chartData);
        const max = Math.max(...chartData);
        const range = max - min || 1;

        // padding
        const padX = 12;
        const padY = 16;
        const graphW = w - padX * 2;
        const graphH = h - padY * 2;

        // map points to canvas coordinates
        const points = chartData.map((val, idx) => {
          const x = padX + (idx / (chartData.length - 1)) * graphW;
          // invert y so higher price goes up
          const y = padY + graphH - ((val - min) / range) * graphH;
          return { x, y };
        });

        // draw subtle grid lines
        ctx.strokeStyle = '#2a334a';
        ctx.lineWidth = 0.5;
        for (let i = 0; i <= 4; i++) {
          const y = padY + (i / 4) * graphH;
          ctx.beginPath();
          ctx.moveTo(padX, y);
          ctx.lineTo(w - padX, y);
          ctx.strokeStyle = '#232b3b';
          ctx.stroke();
        }

        // draw area gradient fill
        const gradient = ctx.createLinearGradient(0, padY, 0, h - padY);
        gradient.addColorStop(0, 'rgba(41, 98, 255, 0.25)');
        gradient.addColorStop(0.8, 'rgba(41, 98, 255, 0.02)');
        gradient.addColorStop(1, 'rgba(41, 98, 255, 0)');

        ctx.beginPath();
        points.forEach((p, i) => {
          if (i === 0) ctx.moveTo(p.x, p.y);
          else ctx.lineTo(p.x, p.y);
        });
        // close the shape to bottom
        ctx.lineTo(points[points.length - 1].x, h - padY);
        ctx.lineTo(points[0].x, h - padY);
        ctx.closePath();
        ctx.fillStyle = gradient;
        ctx.fill();

        // draw line
        ctx.beginPath();
        points.forEach((p, i) => {
          if (i === 0) ctx.moveTo(p.x, p.y);
          else ctx.lineTo(p.x, p.y);
        });
        ctx.strokeStyle = '#2962ff';
        ctx.lineWidth = 2.2;
        ctx.shadowColor = '#2962ff';
        ctx.shadowBlur = 10;
        ctx.stroke();
        ctx.shadowBlur = 0;

        // draw small dots at last point
        const last = points[points.length - 1];
        ctx.beginPath();
        ctx.arc(last.x, last.y, 5, 0, 2 * Math.PI);
        ctx.fillStyle = '#2962ff';
        ctx.shadowColor = '#2962ff';
        ctx.shadowBlur = 12;
        ctx.fill();
        ctx.shadowBlur = 0;
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 2;
        ctx.stroke();
      }

      // initial draw
      drawChart();

      // ---- update UI with small random fluctuations (to look live) ----
      function updatePrices() {
        // update each asset with a small random change
        for (let key in assets) {
          const asset = assets[key];
          // random delta between -0.35% and +0.35%
          const deltaPercent = (Math.random() - 0.49) * 0.7;
          let newPrice = asset.price * (1 + deltaPercent / 100);
          // keep price in reasonable bounds
          if (key === 'BTC') newPrice = Math.min(68000, Math.max(60000, newPrice));
          if (key === 'ETH') newPrice = Math.min(3800, Math.max(3000, newPrice));
          if (key === 'SOL') newPrice = Math.min(200, Math.max(100, newPrice));
          if (key === 'AAPL') newPrice = Math.min(250, Math.max(200, newPrice));
          if (key === 'TSLA') newPrice = Math.min(300, Math.max(200, newPrice));

          asset.price = newPrice;
          // update change based on 24h open (simulate as fixed baseline)
          const basePrice = {
            BTC: 62390, ETH: 3374, SOL: 143.5, AAPL: 225.6, TSLA: 251.6
          }[key];
          const change = ((newPrice - basePrice) / basePrice) * 100;
          asset.change = change;

          // format price
          let formattedPrice = '';
          if (key === 'BTC') formattedPrice = '$' + newPrice.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          else if (key === 'ETH') formattedPrice = '$' + newPrice.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          else if (key === 'SOL') formattedPrice = '$' + newPrice.toFixed(2);
          else formattedPrice = '$' + newPrice.toFixed(2);

          // update DOM
          const priceEl = document.getElementById(asset.elementPrice);
          if (priceEl) priceEl.textContent = formattedPrice;

          const changeEl = document.getElementById(asset.elementChange);
          if (changeEl) {
            const isPositive = change >= 0;
            changeEl.className = `price-change ${isPositive ? 'positive' : 'negative'}`;
            changeEl.innerHTML = `<i class="fas fa-caret-${isPositive ? 'up' : 'down'}"></i> ${Math.abs(change).toFixed(2)}%`;
          }

          // for BTC update chart and big display
          if (key === 'BTC') {
            document.getElementById('chart-big-price').textContent = formattedPrice;
            const bigChangeEl = document.getElementById('chart-big-change');
            const isPositive = change >= 0;
            bigChangeEl.textContent = `${isPositive ? '+' : ''}${change.toFixed(2)}%`;
            bigChangeEl.style.color = isPositive ? '#00c853' : '#ff3d5a';
            bigChangeEl.style.background = isPositive ? 'rgba(0, 200, 83, 0.1)' : 'rgba(255, 61, 90, 0.1)';

            // update chart data (push new point, remove first)
            chartData.push(newPrice);
            if (chartData.length > 30) chartData.shift();
            drawChart();
          }
        }
      }

      // Update every 1.8 seconds to simulate live market
      setInterval(updatePrices, 1800);

      // also redraw on resize (keep canvas sharp)
      window.addEventListener('resize', () => {
        // optional: keep drawing
        drawChart();
      });

      // slight extra: make order book numbers fluctuate a bit (visual liveliness)
      setInterval(() => {
        // update order book prices and sizes slightly
        const askRows = document.querySelectorAll('.ask-price');
        const bidRows = document.querySelectorAll('.bid-price');
        const sizes = document.querySelectorAll('.order-size');
        // simple random tweaks for realism (just visual)
        askRows.forEach((el, idx) => {
          const base = 63860.2 - idx * 5.2;
          const variation = (Math.random() - 0.5) * 4;
          el.textContent = (base + variation).toFixed(1);
        });
        bidRows.forEach((el, idx) => {
          const base = 63840.5 - idx * 5.1;
          const variation = (Math.random() - 0.5) * 4;
          el.textContent = (base + variation).toFixed(1);
        });
        sizes.forEach((el, idx) => {
          if (idx < 3) { // asks
            el.textContent = (Math.random() * 3 + 0.3).toFixed(2);
          } else {
            el.textContent = (Math.random() * 3 + 0.2).toFixed(2);
          }
        });
      }, 2200);
    })();
  </script>
</body>
</html>