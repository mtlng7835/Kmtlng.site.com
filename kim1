<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ProTrader · live dashboard</title>
  <!-- Font & icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #0b0e14;
      font-family: 'Inter', sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 16px;
    }

    /* main terminal card */
    .trading-ui {
      max-width: 1300px;
      width: 100%;
      background: #131722;
      border-radius: 28px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.03);
      padding: 22px 26px 26px 26px;
      color: #e9edf5;
      transition: all 0.1s ease;
    }

    /* header / top bar */
    .top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 22px;
    }

    .logo-area {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo-icon {
      background: linear-gradient(145deg, #2962ff, #0039cb);
      width: 40px;
      height: 40px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      color: white;
      box-shadow: 0 6px 14px rgba(41, 98, 255, 0.3);
    }

    .logo-text {
      font-weight: 700;
      font-size: 1.4rem;
      letter-spacing: -0.5px;
      background: linear-gradient(to right, #ffffff, #b0c4ff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .market-status {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .status-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(0, 200, 83, 0.08);
      padding: 7px 14px;
      border-radius: 40px;
      border: 1px solid rgba(0, 200, 83, 0.2);
    }

    .live-dot {
      width: 8px;
      height: 8px;
      background: #00c853;
      border-radius: 50%;
      box-shadow: 0 0 10px #00c853;
      animation: pulse 1.6s infinite;
    }

    @keyframes pulse {
      0% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.6; transform: scale(1.2); }
      100% { opacity: 1; transform: scale(1); }
    }

    .status-text {
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      color: #b2e6c2;
      letter-spacing: 0.3px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 16px;
      background: #1c2230;
      padding: 6px 6px 6px 16px;
      border-radius: 40px;
      border: 1px solid #2a3142;
    }

    .balance {
      font-weight: 600;
      font-size: 0.95rem;
      color: #b9c6e0;
    }

    .balance span {
      color: #ffffff;
      font-weight: 700;
      margin-left: 6px;
    }

    .avatar {
      background: #2d3a5e;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      color: #e0e7ff;
      border: 2px solid #3b4b6e;
      font-size: 0.9rem;
    }

    /* main grid */
    .dashboard-grid {
      display: grid;
      grid-template-columns: 1.1fr 2.2fr 1fr;
      gap: 18px;
    }

    /* left panel — watchlist */
    .panel {
      background: #1a1f2e;
      border-radius: 20px;
      border: 1px solid #262e3e;
      padding: 18px 16px;
      box-shadow: 0 8px 16px -6px rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(2px);
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
    }

    .panel-header h3 {
      font-size: 0.9rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #8f9bb5;
    }

    .panel-header i {
      color: #5a6a85;
      font-size: 0.9rem;
    }

    .watchlist {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .watch-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 10px;
      border-radius: 14px;
      transition: all 0.1s ease;
      cursor: default;
      border-left: 2px solid transparent;
    }

    .watch-item.active {
      background: #22293b;
      border-left-color: #2962ff;
    }

    .ticker-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .ticker-symbol {
      font-weight: 700;
      font-size: 0.95rem;
      color: white;
    }

    .ticker-name {
      font-size: 0.7rem;
      color: #7a89a8;
      font-weight: 500;
    }

    .ticker-price {
      text-align: right;
    }

    .price-value {
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: -0.2px;
    }

    .price-change {
      font-size: 0.7rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 3px;
      margin-top: 2px;
    }

    .positive {
      color: #00c853;
    }

    .negative {
      color: #ff3d5a;
    }

    /* middle panel — chart */
    .chart-panel {
      background: #1a1f2e;
      border-radius: 20px;
      border: 1px solid #262e3e;
      padding: 18px 18px 12px 18px;
      display: flex;
      flex-direction: column;
      box-shadow: 0 8px 16px -6px rgba(0, 0, 0, 0.4);
    }

    .chart-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
    }

    .chart-title {
      display: flex;
      align-items: baseline;
      gap: 12px;
    }

    .chart-title h2 {
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.5px;
      color: white;
    }

    .chart-title .symbol-sub {
      font-size: 0.8rem;
      font-weight: 500;
      color: #7a89a8;
      background: #252e40;
      padding: 4px 10px;
      border-radius: 30px;
    }

    .chart-price-display {
      display: flex;
      align-items: baseline;
      gap: 10px;
    }

    .big-price {
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: -1px;
    }

    .big-change {
      font-weight: 600;
      font-size: 1rem;
      color: #00c853;
      background: rgba(0, 200, 83, 0.1);
      padding: 4px 12px;
      border-radius: 30px;
    }

    /* canvas chart */
    .chart-container {
      position: relative;
      width: 100%;
      height: 190px;
      margin: 6px 0 6px 0;
    }

    canvas {
      width: 100%;
      height: 100%;
      display: block;
      border-radius: 12px;
    }

    .timeframes {
      display: flex;
      gap: 8px;
      margin-top: 8px;
      margin-bottom: 4px;
    }

    .tf-btn {
      background: transparent;
      border: none;
      color: #6b7a9a;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 6px 12px;
      border-radius: 10px;
      cursor: default;
      transition: all 0.1s;
      font-family: 'Inter', sans-serif;
    }

    .tf-btn.active {
      background: #2962ff;
      color: white;
      box-shadow: 0 6px 12px -4px #2962ff;
    }

    /* right panel — order book / trades */
    .order-panel {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .order-book {
      background: #1a1f2e;
      border-radius: 20px;
      border: 1px solid #262e3e;
      padding: 16px;
      box-shadow: 0 8px 16px -6px rgba(0, 0, 0, 0.4);
    }

    .order-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 12px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      color: #6f7d99;
    }

    .order-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      padding: 6px 0;
      border-bottom: 1px solid #212838;
      font-weight: 500;
    }

    .order-row:last-child {
      border-bottom: none;
    }

    .ask-price {
      color: #ff3d5a;
    }

    .bid-price {
      color: #00c853;
    }

    .order-size {
      color: #a4b3d1;
      font-weight: 400;
    }

    .depth-bar {
      height: 2px;
      background: #2a334a;
      margin-top: 3px;
      border-radius: 4px;
      overflow: hidden;
    }

    .depth-fill {
      height: 2px;
      background: #2962ff;
      width: 60%;
    }

    /* recent trades */
    .recent-trades {
      background: #1a1f2e;
      border-radius: 20px;
      border: 1px solid #262e3e;
      padding: 16px;
      box-shadow: 0 8px 16px -6px rgba(0, 0, 0, 0.4);
    }

    .trade-item {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      padding: 6px 0;
      font-weight: 500;
    }

    .trade-time {
      color: #62708c;
    }

    /* footer / action buttons */
    .action-bar {
      display: flex;
      gap: 12px;
      margin-top: 22px;
    }

    .btn {
      flex: 1;
      padding: 14px 0;
      border-radius: 16px;
      border: none;
      font-weight: 700;
      font-size: 0.95rem;
      font-family: 'Inter', sans-serif;
      cursor: default;
      transition: all 0.15s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .btn-buy {
      background: #00c853;
      color: #0b0e14;
      box-shadow: 0 10px 20px -8px #00c853;
    }

    .btn-sell {
      background: #ff3d5a;
      color: white;
      box-shadow: 0 10px 20px -8px #ff3d5a;
    }

    .btn-outline {
      background: transparent;
      border: 1px solid #2d374b;
      color: #b9c6e0;
      box-shadow: none;
    }

    .btn-outline i {
      color: #6f7d99;
    }

    /* subtle dividers */
    .divider {
      width: 100%;
      height: 1px;
      background: #212838;
      margin: 12px 0;
    }

    /* Responsive fine-tuning */
    @media (max-width: 1000px) {
      .dashboard-grid {
        grid-template-columns: 1fr 1fr;
      }
      .order-panel {
        grid-column: span 2;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
      }
    }

    @media (max-width: 700px) {
      .dashboard-grid {
        grid-template-columns: 1fr;
      }
      .order-panel {
        grid-column: span 1;
        grid-template-columns: 1fr;
      }
      .top-bar {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
      }
      .market-status {
        width: 100%;
        justify-content: space-between;
      }
    }
  </style>
</head>
